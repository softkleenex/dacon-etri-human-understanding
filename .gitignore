# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data directories (Absolutely DO NOT commit data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Models and Submissions
models/*
!models/.gitkeep
submissions/*
!submissions/.gitkeep
!submissions/submission_log.csv

# Environments
.env
.venv
env/
venv/
ENV/
.pytest_cache/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints

# DVC (Data Version Control)
/data/**/*.dvc
.dvc/config.local
.dvc/cache/
.dvc/tmp/

# Kaggle/Dacon specific
kaggle.json
*.zip
*.tar
*.tar.gz

# Logs and OS files
.DS_Store
.DS_Store?
._*
logs/
*.log
experiment_history.json
optuna_study.db
