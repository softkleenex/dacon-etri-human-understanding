# API Keys
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Optional local APIs
WEATHER_API_KEY=your_weather_api_key_here

# Submission credentials (set in shell or local .env; never commit real values)
DACON_TOKEN=your_dacon_token_here
DACON_TEAMNAME=your_dacon_team_name_here

# Global Keys (optional; often set globally in ~/.zshrc)
# WANDB_API_KEY=your_wandb_key_here
# HF_TOKEN=your_huggingface_token_here
